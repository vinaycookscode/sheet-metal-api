# --- API ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sheetmetal
# or individual parts:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sheetmetal

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# --- Document storage ---
# Leave R2_* blank to store files on local disk (DOCS_DIR). Set all four to use Cloudflare R2.
DOCS_DIR=./uploads
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional override (defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com):
# R2_ENDPOINT=
