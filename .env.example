# --- API ---
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:4200

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sheetmetal
# or individual parts:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sheetmetal

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# --- Storage (documents) ---
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=sheetmetal-docs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
